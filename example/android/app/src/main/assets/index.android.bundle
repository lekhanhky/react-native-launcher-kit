ions',titleEn:'Positions & Directions',titleVi:'V\u1ecb Tr\xed & Ph\u01b0\u01a1ng H\u01b0\u1edbng',icon:'\ud83e\udded',color:'#059669',cards:[{id:'in',english:'In (Inside)',ipa:'/\u026an/',vietnamese:'\u1ede B\xean Trong',category:'positions_directions',emoji:'\ud83d\udce5',color:'#3B82F6',exampleEn:'The pencil is in the pencil case.',exampleVi:'C\xe2y b\xfat ch\xec n\u1eb1m \u1edf b\xean trong h\u1ed9p b\xfat.',funFact:'Gi\u1edbi t\u1eeb ch\u1ec9 v\u1ecb tr\xed gi\xfap ch\xfang ta m\xf4 t\u1ea3 \u0111\u1ed3 v\u1eadt n\u1eb1m \u1edf \u0111\xe2u m\u1ed9t c\xe1ch ch\xednh x\xe1c.'},{id:'on',english:'On',ipa:'/\u0251\u02d0n/',vietnamese:'\u1ede Ph\xeda Tr\xean',category:'positions_directions',emoji:'\ud83d\udd1b',color:'#10B981',exampleEn:'The red apple sits on the table.',exampleVi:'Qu\u1ea3 t\xe1o \u0111\u1ecf n\u1eb1m \u1edf tr\xean m\u1eb7t b\xe0n.',funFact:'D\xf9ng "On" khi \u0111\u1ed3 v\u1eadt ti\u1ebfp x\xfac tr\u1ef1c ti\u1ebfp tr\xean b\u1ec1 m\u1eb7t c\u1ee7a v\u1eadt kh\xe1c.'},{id:'under',english:'Under',ipa:'/\u02c8\u028cn.d\u025a/',vietnamese:'\u1ede Ph\xeda D\u01b0\u1edbi',category:'positions_directions',emoji:'\ud83d\udc47',color:'#F59E0B',exampleEn:'The cat sleeps under the warm chair.',exampleVi:'Ch\xfa m\xe8o con n\u1eb1m ng\u1ee7 \u1edf d\u01b0\u1edbi chi\u1ebfc gh\u1ebf \u1ea5m \xe1p.',funFact:'M\xe8o r\u1ea5t th\xedch chui xu\u1ed1ng d\u01b0\u1edbi g\u1ea7m gi\u01b0\u1eddng v\xec c\u1ea3m th\u1ea5y an to\xe0n.'},{id:'behind',english:'Behind',ipa:'/b\u026a\u02c8ha\u026and/',vietnamese:'\u1ede Ph\xeda Sau',category:'positions_directions',emoji:'\ud83d\ude48',color:'#6366F1',exampleEn:'The boy hides behind the big tree.',exampleVi:'C\u1eadu b\xe9 tr\u1ed1n \u1edf ph\xeda sau th\xe2n c\xe2y to.',funFact:'Ch\u01a1i tr\u1ed1n t\xecm gi\xfap r\xe8n luy\u1ec7n kh\u1ea3 n\u0103ng \u0111\u1ecbnh h\u01b0\u1edbng kh\xf4ng gian tuy\u1ec7t v\u1eddi.'},{id:'in_front_of',english:'In front of',ipa:'/\u026an fr\u028cnt \u028cv/',vietnamese:'\u1ede Ph\xeda Tr\u01b0\u1edbc',category:'positions_directions',emoji:'\ud83d\udeb6',color:'#EC4899',exampleEn:'Stand politely in front of the teacher.',exampleVi:'\u0110\u1ee9ng l\u1ec5 ph\xe9p \u1edf ph\xeda tr\u01b0\u1edbc m\u1eb7t th\u1ea7y c\xf4.',funFact:'Nh\xecn th\u1eb3ng v\u1ec1 ph\xeda tr\u01b0\u1edbc gi\xfap ch\xfang ta b\u01b0\u1edbc \u0111i v\u1eefng v\xe0ng t\u1ef1 tin.'},{id:'next_to',english:'Next to (Beside)',ipa:'/nekst tu\u02d0/',vietnamese:'\u1ede Ngay B\xean C\u1ea1nh',category:'positions_directions',emoji:'\ud83e\udd1d',color:'#0284C7',exampleEn:'Sit next to your best friend in class.',exampleVi:'Ng\u1ed3i ngay b\xean c\u1ea1nh ng\u01b0\u1eddi b\u1ea1n th\xe2n trong l\u1edbp h\u1ecdc.',funFact:'C\xf3 m\u1ed9t ng\u01b0\u1eddi b\u1ea1n t\u1ed1t ng\u1ed3i b\xean c\u1ea1nh l\xe0m gi\u1edd h\u1ecdc th\xeam vui v\u1ebb.'},{id:'between',english:'Between',ipa:'/b\u026a\u02c8twi\u02d0n/',vietnamese:'\u1ede Gi\u1eefa (2 v\u1eadt)',category:'positions_directions',emoji:'\ud83e\udd6a',color:'#D97706',exampleEn:'The strawberry is between two cookies.',exampleVi:'Qu\u1ea3 d\xe2u t\xe2y n\u1eb1m \u1edf gi\u1eefa hai chi\u1ebfc b\xe1nh quy.',funFact:'D\xf9ng "between" khi \u1edf gi\u1eefa 2 \u0111\u1ed1i t\u01b0\u1ee3ng v\xe0 "among" khi \u1edf gi\u1eefa nhi\u1ec1u \u0111\u1ed1i t\u01b0\u1ee3ng.'},{id:'above',english:'Above',ipa:'/\u0259\u02c8b\u028cv/',vietnamese:'\u1ede Cao H\u01a1n',category:'positions_directions',emoji:'\u2601\ufe0f',color:'#06B6D4',exampleEn:'Birds fly high above the green forest.',exampleVi:'Nh\u1eefng ch\xfa chim bay l\u01b0\u1ee3n \u1edf tr\xean cao ph\xeda tr\xean khu r\u1eebng.',funFact:'D\xf9ng "Above" khi kh\xf4ng c\xf3 s\u1ef1 ti\u1ebfp x\xfac b\u1ec1 m\u1eb7t.'},{id:'left',english:'Left',ipa:'/left/',vietnamese:'B\xean Tay Tr\xe1i',category:'positions_directions',emoji:'\ud83d\udc48',color:'#8B5CF6',exampleEn:'Raise your left hand high.',exampleVi:'Gi\u01a1 cao b\xe0n tay b\xean tr\xe1i c\u1ee7a b\xe9 l\xean n\xe0o.',funFact:'Kho\u1ea3ng 10% d\xe2n s\u