ature_space',emoji:'\ud83c\udf0a',color:'#0284C7',exampleEn:'The peaceful river flows gently into the sea.',exampleVi:'D\xf2ng s\xf4ng \xeam \u0111\u1ec1m ch\u1ea3y xu\xf4i ra bi\u1ec3n l\u1edbn.',funFact:'S\xf4ng M\xea K\xf4ng ch\u1ea3y qua Vi\u1ec7t Nam b\u1ed3i \u0111\u1eafp ph\xf9 sa m\xe0u m\u1ee1 cho \u0111\u1ed3ng b\u1eb1ng.'},{id:'sea',english:'Sea',ipa:'/si\u02d0/',vietnamese:'Bi\u1ec3n C\u1ea3',category:'nature_space',emoji:'\ud83c\udf0a',color:'#1E40AF',exampleEn:'Listen to the sound of ocean waves.',exampleVi:'L\u1eafng nghe ti\u1ebfng s\xf3ng bi\u1ec3n r\xec r\xe0o v\u1ed7 b\u1edd.',funFact:'\u0110\u1ea1i d\u01b0\u01a1ng bao ph\u1ee7 h\u01a1n 70% b\u1ec1 m\u1eb7t Tr\xe1i \u0110\u1ea5t ch\xfang ta.'},{id:'forest',english:'Forest',ipa:'/\u02c8f\u0254\u02d0r.\u026ast/',vietnamese:'Khu R\u1eebng',category:'nature_space',emoji:'\ud83c\udf32',color:'#166534',exampleEn:'Birds sing happily in the green forest.',exampleVi:'Chim h\xf3t l\xedu lo trong khu r\u1eebng xanh ng\xe1t.',funFact:'R\u1eebng r\u1eadm \u0111\u01b0\u1ee3c v\xed nh\u01b0 l\xe1 ph\u1ed5i xanh kh\u1ed5ng l\u1ed3 cung c\u1ea5p oxy cho Tr\xe1i \u0110\u1ea5t.'},{id:'tree',english:'Tree',ipa:'/tri\u02d0/',vietnamese:'C\xe2y Xanh',category:'nature_space',emoji:'\ud83c\udf33',color:'#15803D',exampleEn:'The big shady tree provides cool shade.',exampleVi:'C\xe2y b\xf3ng m\xe1t t\u1ecfa b\xf3ng r\xe2m che ch\u1edf m\u1ecdi ng\u01b0\u1eddi.',funFact:'C\xf3 nh\u1eefng c\xe2y c\u1ed5 th\u1ee5 c\xf3 th\u1ec3 s\u1ed1ng l\xe2u h\u01a1n 4.000 n\u0103m tu\u1ed5i!'},{id:'flower',english:'Flower',ipa:'/\u02c8fla\u028a.\u025a/',vietnamese:'B\xf4ng Hoa',category:'nature_space',emoji:'\ud83c\udf38',color:'#F43F5E',exampleEn:'Colorful flowers bloom in spring.',exampleVi:'Mu\xf4n hoa khoe s\u1eafc r\u1ef1c r\u1ee1 khi m\xf9a xu\xe2n v\u1ec1.',funFact:'Hoa t\u1ecfa h\u01b0\u01a1ng th\u01a1m ng\xe1t \u0111\u1ec3 thu h\xfat ong b\u01b0\u1edbm \u0111\u1ebfn th\u1ee5 ph\u1ea5n.'}]},{id:'insects',titleEn:'Insects & Bugs',ti