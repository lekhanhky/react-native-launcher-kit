h s\u1ebd l\xe0 c\xe1ch t\u1ed1t nh\u1ea5t \u0111\u1ec3 b\u1ea3o v\u1ec7 s\u1ee9c kh\u1ecfe m\u1ed7i ng\xe0y.'},{id:'dirty',english:'Dirty',ipa:'/\u02c8d\u025d\u02d0.t\u032ci/',vietnamese:'B\u1ea9n / L\u1ea5m B\xf9n',category:'opposite_adjectives',emoji:'\ud83d\udc3e',color:'#92400E',exampleEn:'Wipe muddy paws after playing in the garden.',exampleVi:'Lau s\u1ea1ch nh\u1eefng b\xe0n ch\xe2n l\u1ea5m b\xf9n sau khi ch\u01a1i ngo\xe0i v\u01b0\u1eddn.',funFact:'Ngh\u1ecbch \u0111\u1ea5t c\xe1t vui nh\u01b0ng nh\u1edb r\u1eeda s\u1ea1ch ch\xe2n tay sau khi ch\u01a1i xong nh\xe9!'},{id:'old',english:'Old',ipa:'/o\u028ald/',vietnamese:'C\u0169 / Gi\xe0',category:'opposite_adjectives',emoji:'\ud83c\udfdb\ufe0f',color:'#64748B',exampleEn:'The wise old banyan tree has lived for 200 years.',exampleVi:'C\xe2y \u0111a c\u1ed5 th\u1ee5 \u0111\xe3 s\u1ed1ng th\u1ecd h\u01a1n 200 n\u0103m tu\u1ed5i.',funFact:'T\u1eeb "Old" v\u1eeba c\xf3 ngh\u0129a l\xe0 \u0111\u1ed3 v\u1eadt c\u0169, v\u1eeba c\xf3 ngh\u0129a l\xe0 tu\u1ed5i t\xe1c cao.'},{id:'new',english:'New',ipa:'/nu\u02d0/',vietnamese:'M\u1edbi Tinh',category:'opposite_adjectives',emoji:'\u2728',color:'#8B5CF6',exampleEn:'Wear a brand new uniform on the first school day.',exampleVi:'M\u1eb7c b\u1ed9 \u0111\u1ed3ng ph\u1ee5c m\u1edbi tinh t\u01b0\u01a1m trong ng\xe0y khai tr\u01b0\u1eddng.',funFact:'M\u1edf m\u1ed9t trang v\u1edf m\u1edbi mang l\u1ea1i c\u1ea3m gi\xe1c h\u1ee9ng kh\u1edfi h\u1ecdc t\u1eadp ng\u1eadp tr\xe0n.'},{id:'hot_adj',english:'Hot',ipa:'/h\u0251\u02d0t/',vietnamese:'N\xf3ng',category:'opposite_adjectives',emoji:'\ud83d\udd25',color:'#EF4444',exampleEn:'Be careful, the soup is very hot!',exampleVi:'C\u1ea9n th\u1eadn b\xe9 nh\xe9, b\xe1t canh \u0111ang r\u1ea5t n\xf3ng!',funFact:'Nhi\u1ec7t \u0111\u1ed9 b\u1ec1 m\u1eb7t c\u1ee7a M\u1eb7t tr\u1eddi l\xean t\u1edbi 5.500 \u0111\u1ed9 C.'},{id:'cold_adj',english:'Cold',ipa:'/ko\u028ald/',vietnamese:'L\u1ea1nh',category:'opposite_adjectives',emoji:'\ud83e\uddca',color:'#0284C7',exampleEn:'Ice cubes are frozen solid and cold.',exampleVi:'Nh\u1eefng vi\xean \u0111\xe1 l\u1ea1nh \u0111\xf3ng b\u0103ng c\u1ee9ng ng\u1eafc v\xe0 bu\u1ed1t gi\xe1.',funFact:'N\u01b0\u1edbc b\u1eaft \u0111\u1ea7u \u0111\xf3ng b\u0103ng th\xe0nh \u0111\xe1 \u1edf nhi\u1ec7t \u0111\u1ed9 0 \u0111\u1ed9 C.'},{id:'happy_adj',english:'Happy',ipa:'/\u02c8h\xe6p.i/',vietnamese:'Vui V\u1ebb',category:'opposite_adjectives',emoji:'\ud83d\ude04',color:'#EAB308',exampleEn:'A joyful smile makes everyone happy.',exampleVi:'M\u1ed9t n\u1ee5 c\u01b0\u1eddi vui t\u01b0\u01a1i khi\u1ebfn t\u1ea5t c\u1ea3 m\u1ecdi ng\u01b0\u1eddi \u0111\u1ec1u h\xe2n hoan.',funFact:'Ni\u1ec1m vui c\xf3 th\u1ec3 lan t\u1ecfa t\u1eeb ng\u01b0\u1eddi n\xe0y sang ng\u01b0\u1eddi kh\xe1c qua n\u1ee5 c\u01b0\u1eddi.'},{id:'sad_adj',english:'Sad',ipa:'/s\xe6d/',vietnamese:'Bu\u1ed3n B\xe3',category:'opposite_adjectives',emoji:'\ud83d\ude22',color:'#60A5FA',exampleEn:'Give a gentle smile to cheer up someone sad.',exampleVi:'N\u1edf m\u1ed9t n\u1ee5 c\u01b0\u1eddi hi\u1ec1n h\u1eadu \u0111\u1ec3 an \u1ee7i ng\u01b0\u1eddi b\u1ea1n \u0111ang bu\u1ed3n.',funFact:'Chia s\u1ebb n\u1ed7i bu\u1ed3n c\xf9ng ng\u01b0\u1eddi th\xe2n s\u1ebd gi\xfap n\u1ed7i bu\u1ed3n v\u01a1i \u0111i m\u1ed9t n\u1eeda.'}]}]},526,[]);
