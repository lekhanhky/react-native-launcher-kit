0\u1eddi b\u1ec7nh.',funFact:'Khi nghe c\xf2i xe c\u1ee9u th\u01b0\u01a1ng, t\u1ea5t c\u1ea3 xe c\u1ed9 \u0111\u1ec1u nh\u01b0\u1eddng \u0111\u01b0\u1eddng \u01b0u ti\xean.'},{id:'police_car',english:'Police Car',ipa:'/p\u0259\u02c8li\u02d0s k\u0251\u02d0r/',vietnamese:'Xe C\u1ea3nh S\xe1t',category:'vehicles',emoji:'\ud83d\ude93',color:'#2563EB',exampleEn:'The police car patrols the city streets.',exampleVi:'Xe c\u1ea3nh s\xe1t tu\u1ea7n tra tr\xean c\xe1c con ph\u1ed1.',funFact:'\u0110\xe8n nh\u1ea5p nh\xe1y xanh \u0111\u1ecf gi\xfap m\u1ecdi ng\u01b0\u1eddi nh\u1eadn ra xe c\u1ea3nh s\xe1t t\u1eeb xa.'},{id:'fire_truck',english:'Fire Truck',ipa:'/\u02c8fa\u026ar \u02cctr\u028ck/',vietnamese:'Xe C\u1ee9u H\u1ecfa',category:'vehicles',emoji:'\ud83d\ude92',color:'#DC2626',exampleEn:'The big red fire truck puts out fires.',exampleVi:'Xe c\u1ee9u h\u1ecfa \u0111\u1ecf r\u1ef1c d\u1eadp t\u1eaft \u0111\xe1m ch\xe1y.',funFact:'Xe c\u1ee9u h\u1ecfa mang theo thang d\xe0i v\xe0 v\xf2i r\u1ed3ng phun n\u01b0\u1edbc si\xeau m\u1ea1nh!'},{id:'tractor',english:'Tractor',ipa:'/\u02c8tr\xe6k.t\u025a/',vietnamese:'M\xe1y C\xe0y',category:'vehicles',emoji:'\ud83d\ude9c',color:'#16A34A',exampleEn:'The tractor works hard on the farm.',exampleVi:'M\xe1y c\xe0y l\xe0m vi\u1ec7c ch\u0103m ch\u1ec9 tr\xean c\xe1nh \u0111\u1ed3ng.',funFact:'M\xe1y c\xe0y c\xf3 b\xe1nh xe kh\u1ed5ng l\u1ed3 gi\xfap kh\xf4ng b\u1ecb l\xfan trong b\xf9n \u0111\u1ea5t.'},{id:'rocket',english:'Rocket',ipa:'/\u02c8r\u0251\u02d0.k\u026at/',vietnamese:'T\xean L\u1eeda',category:'vehicles',emoji:'\ud83d\ude80',color:'#8B5CF6',exampleEn:'The rocket flies into outer space.',exampleVi:'T\xean l\u1eeda bay v\xfat v\xe0o kh\xf4ng gian v\u0169 tr\u1ee5.',funFact:'T\xean l\u1eeda ph\u1ea3i bay v\u1edbi t\u1ed1c \u0111\u1ed9 h\u01a1n 40.000 km/h \u0111\u1ec3 tho\xe1t kh\u1ecfi l\u1ef1c h\xfat Tr\xe1i \u0110\u1ea5t!'},{id:'taxi',english:'Taxi',ipa:'/\u02c8t\xe6k.si/',vietnamese:'Xe T\u1eafc Xi',category:'vehicles',emoji: