1n tr\xf4i.',funFact:'R\xe1i c\xe1 bi\u1ec3n c\xf3 b\u1ed9 l\xf4ng d\xe0y nh\u1ea5t trong v\u01b0\u01a1ng qu\u1ed1c \u0111\u1ed9ng v\u1eadt v\u1edbi 1 tri\u1ec7u s\u1ee3i l\xf4ng/cm\xb2!'},{id:'eel',english:'Eel',ipa:'/i\u02d0l/',vietnamese:'L\u01b0\u01a1n Bi\u1ec3n / C\xe1 Ch\xecnh',category:'sea_creatures',emoji:'\ud83d\udc0d',color:'#059669',exampleEn:'The electric eel can generate electric sparks.',exampleVi:'C\xe1 ch\xecnh \u0111i\u1ec7n c\xf3 th\u1ec3 ph\xf3ng ra d\xf2ng \u0111i\u1ec7n \u0111\u1ec3 t\u1ef1 v\u1ec7.',funFact:'L\u01b0\u01a1n bi\u1ec3n b\u01a1i u\u1ed1n l\u01b0\u1ee3n h\xecnh ch\u1eef S uy\u1ec3n chuy\u1ec3n qua c\xe1c khe \u0111\xe1 ng\u1ea7m.'}]},{id:'science_wonders',titleEn:'Science & Wonders',titleVi:'Khoa H\u1ecdc K\u1ef3 Di\u1ec7u',icon:'\ud83d\udd2c',color:'#8B5CF6',cards:[{id:'magnet',english:'Magnet',ipa:'/\u02c8m\xe6\u0261.n\u0259t/',vietnamese:'Nam Ch\xe2m',category:'science_wonders',emoji:'\ud83e\uddf2',color:'#DC2626',exampleEn:'The red horseshoe magnet attracts iron nails.',exampleVi:'Thanh nam ch\xe2m h\xecnh m\xf3ng ng\u1ef1a h\xfat nh\u1eefng chi\u1ebfc \u0111inh s\u1eaft.',funFact:'Nam ch\xe2m c\xf3 2 c\u1ef1c B\u1eafc v\xe0 Nam: C\xf9ng c\u1ef1c th\xec \u0111\u1ea9y nhau, kh\xe1c c\u1ef1c th\xec h\xfat nhau!'},{id:'gravity',english:'Gravity',ipa:'/\u02c8\u0261r\xe6v.\u0259.t\u032ci/',vietnamese:'Tr\u1ecdng L\u1ef1c (L\u1ef1c H\xfat)',category:'science_wonders',emoji:'\ud83c\udf4e',color:'#10B981',exampleEn:'Gravity pulls the falling apple to the ground.',exampleVi:'Tr\u1ecdng l\u1ef1c k\xe9o qu\u1ea3 t\xe1o r\u01a1i th\u1eb3ng xu\u1ed1ng m\u1eb7t \u0111\u1ea5t.',funFact:'Nh\u1edd c\xf3 tr\u1ecdng l\u1ef1c c\u1ee7a Tr\xe1i \u0110\u1ea5t m\xe0 ch\xfang ta c\xf3 th\u1ec3 \u0111\u1ee9ng v\u1eefng tr\xean m\u1eb7t \u0111\u1ea5t kh\xf4ng b\u1ecb bay l\u01a1 l\u1eedng.'},{id:'light',english:'Light',ipa:'/la\u026at/',vietnamese:'\xc1nh S\xe1ng',category:'science_wonders',emoji:'\ud83d\udca1',color:'#FACC15',exampleEn:'Light travels su